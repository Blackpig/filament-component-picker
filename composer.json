{
    "name": "blackpig-creatif/filament-component-picker",
    "description": "Add a component picker to your filament RichEditor fields",
    "keywords": [
        "blackpig-creatif",
        "laravel",
        "filament-component-picker"
    ],
    "homepage": "https://github.com/blackpig/filament-component-picker",
    "support": {
        "issues": "https://github.com/blackpig/filament-component-picker/issues",
        "source": "https://github.com/blackpig/filament-component-picker"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Blackpig Creatif",
            "email": "stuart@blackpig.eu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "filament/filament": "^3.0",
        "illuminate/contracts": "^10.0|^11.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.1",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "BlackpigCreatif\\FilamentComponentPicker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlackpigCreatif\\FilamentComponentPicker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "./vendor/bin/pest tests/",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BlackpigCreatif\\FilamentComponentPicker\\FilamentComponentPickerServiceProvider"
            ],
            "aliases": {
                "FilamentComponentPicker": "BlackpigCreatif\\FilamentComponentPicker\\Facades\\FilamentComponentPicker"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}